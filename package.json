{
  "name": "scrcpy-webcast",
  "productName": "Scrcpy WebCast",
  "version": "1.0.0",
  "description": "Embedded Android screen mirroring for Electron: scrcpy-server + WebCodecs, no native scrcpy binary required.",
  "main": "dist/main/index.js",
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:main\" \"npm:dev:preload\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:main": "vite build --watch --config vite.main.ts --mode=development",
    "dev:preload": "vite build --watch --config vite.preload.ts --mode=development",
    "dev:renderer": "vite",
    "dev:electron": "node script/dev.mjs",
    "build:main": "vite build --config vite.main.ts",
    "build:preload": "vite build --config vite.preload.ts",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "electron ./dist/main/index.js",
    "typecheck": "tsc --noEmit",
    "smoke": "node script/smoke.mjs",
    "dist": "npm run build && electron-builder --win portable",
    "dist:dir": "npm run build && electron-builder --win dir"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.2",
    "@yume-chan/scrcpy": "^1.1.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "^1.1.0",
    "@yume-chan/stream-extra": "^1.0.0",
    "concurrently": "^9.0.1",
    "electron": "30.5.1",
    "electron-builder": "^26.18.0",
    "licia": "^1.48.0",
    "luna-modal": "^1.3.3",
    "luna-toolbar": "^0.9.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sass": "^1.80.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
